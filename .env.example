# ==================== GOOGLE OAUTH ====================
GOOGLE_CLIENT_ID=seu_id_cliente.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_secret
SESSION_SECRET=sua_string
BACKEND_URL=http://localhost:3000
# ==================== DATABASE ====================
DATABASE_URL=postgresql://user:password@host:

# ==================== JWT ====================
JWT_SECRET=seu_secret
JWT_EXPIRATION=1h

# ==================== EMAIL ====================
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app_gmail

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# ==================== SERVER ====================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ==================== ADMIN ====================
ADMIN_EMAILS=email@gmailc.om

# ==================== PAGAMENTOS (Stripe/Pagar.me) ====================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# PAGAR_ME_API_KEY=sua_api_key_aqui

# ==================== RATE LIMIT ====================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== LOGGING ====================
LOG_LEVEL=info
